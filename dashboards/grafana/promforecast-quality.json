{
  "title": "promforecast — Quality",
  "uid": "promforecast-quality",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["promforecast", "forecasting", "quality"],
  "timezone": "",
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "group",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(forecast_quality_score, group)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(forecast_quality_score{group=~\"$group\"}, id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(forecast_quality_score{group=~\"$group\",id=~\"$id\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Mean quality (0..1)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "avg(forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"})",
          "legendFormat": "mean quality"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.7 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Series above 0.7 quality",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "count(forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"} > 0.7)",
          "legendFormat": "high quality"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Series below 0.3 quality",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "count(forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"} < 0.3)",
          "legendFormat": "low quality"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Quality distribution over time",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "quantile(0.1, forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"})",
          "legendFormat": "p10"
        },
        {
          "expr": "quantile(0.5, forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"})",
          "legendFormat": "p50"
        },
        {
          "expr": "quantile(0.9, forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"})",
          "legendFormat": "p90"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Quality by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "avg by (model) (forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"})",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "type": "table",
      "id": 6,
      "title": "Lowest-quality series (current)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "bottomk(20, forecast_quality_score{group=~\"$group\",id=~\"$id\",model=~\"$model\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1 },
        "overrides": []
      },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true } } }
      ]
    }
  ]
}
